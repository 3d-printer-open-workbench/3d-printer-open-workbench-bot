# Template — install.sh --security-timer replaces @ROOT@ and copies it to ~/.config/systemd/user/
[Unit]
Description=3D Printer Open Workbench — daily security summary (local logs -> Telegram)

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 @ROOT@/.claude/hooks/guvenlik_ozet.py
