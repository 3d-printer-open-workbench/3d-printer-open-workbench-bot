# Copy to .env (install.sh does this) and fill in. .env is git-ignored — never commit it.

# --- Required ---------------------------------------------------------------
# Telegram bot token from @BotFather (looks like <digits>:<letters>)
TELEGRAM_BOT_TOKEN=
# Your own Telegram chat id — the bot answers ONLY this chat and refuses to start without it.
# Find it: send any message to your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
TELEGRAM_CHAT_ID=0

# --- Shop identity (shown in posters, quotes, captions) ----------------------
WORKBENCH_SHOP_NAME=Open Workbench
WORKBENCH_SHOP_URL=https://example.com
WORKBENCH_PINTEREST_URL=
# Local technical poster (coo/poster_sablon.py) header/footer; empty = derived from the shop name / URL above
WORKBENCH_POSTER_BRAND=
WORKBENCH_POSTER_SITE=
WORKBENCH_POSTER_SERIES=TASARIM OBJELER / 3D PRINT SERIES

# --- Printer (read-only status/camera; the bot NEVER starts prints) ----------
# LAN IP of an SDCP v3 printer (e.g. Elegoo Centauri Carbon)
PRINTER_IP=

# --- Optional sibling services -----------------------------------------------
# 3d-printer-open-workbench-erp REST API
ERP_URL=http://127.0.0.1:8000
# 3d-printer-open-workbench-studio web UI / MCP (http://.../mcp)
STUDIO_URL=http://127.0.0.1:7870

# --- Optional AI services ----------------------------------------------------
# Gemini API (free tier is enough): print-failure watch + end-of-print report only
GEMINI_API_KEY=
GEMINI_GORUNTU_MODELI=
GEMINI_RAPOR_MODELI=
# 0 = do not pass --chrome to Claude Code (no Claude in Chrome / Google Flow steps)
WORKBENCH_CLAUDE_CHROME=1
# Seconds; 0 = no upper limit for a Claude agent run (you can cancel from Telegram)
WORKBENCH_CLAUDE_ZAMAN_ASIMI=0
# Force a GPU index for AI jobs (nvidia-smi order); empty = auto (most VRAM)
WORKBENCH_GPU=

# --- Paths (defaults are relative to the repo root) --------------------------
# WORKBENCH_ROOT=
# WORKBENCH_DATA=          # default: <root>/veri
# WORKBENCH_CONFIG=        # default: <root>/config
# WORKBENCH_ENVS=          # default: <root>/ortamlar  (.venv-ai3d, .venv-cad, .venv-gorsel; optional)
# WORKBENCH_AI_TOOLS=      # default: <root>/yz-araclari (ComfyUI, Hunyuan3D-2, models)
# WORKBENCH_ERP_DB=        # default: <data>/erp/workbench_erp.db

# --- Claude Code agent permissions -------------------------------------------
# Headless agents cannot answer permission prompts, so the default is bypassPermissions
# (deny rules in .claude/settings.json still apply). Use e.g. "acceptEdits" or "default" for a stricter setup
# (then allow the tools you need in .claude/settings.json).
WORKBENCH_CLAUDE_PERMISSION_MODE=bypassPermissions
