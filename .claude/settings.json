{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "WebSearch",
      "WebFetch",
      "mcp__workbench-erp__*",
      "mcp__workbench-studio__*"
    ],
    "deny": [
      "Edit(veri/00_Onay/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guvenlik_kapisi.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
